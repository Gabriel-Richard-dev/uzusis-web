# Opcional: o compose sobe sem .env, com os padrões abaixo. Para mudar algo,
# copie para .env (fora do git) ou use: env VAR=valor docker compose ...

# ---- Perfis ----
# stripe = sobe o stripe-cli (só faz sentido com as chaves Stripe abaixo)
# COMPOSE_PROFILES=stripe

# ---- Endereço público ----
# Porta do host onde a loja responde. PUBLIC_URL vem dela; mude as duas juntas.
# Trocar depois do primeiro boot exige reimportar o realm (README, "Reimportar o realm").
WEB_PORT=8080
# PUBLIC_URL=http://localhost:8080
# Interface do host onde o web escuta. 127.0.0.1 = só esta máquina (os usuários
# de teste do realm têm senha pública). 0.0.0.0 abre para a rede (proxy de borda
# em outra máquina).
WEB_BIND=127.0.0.1
MAILPIT_PORT=8025

# ---- Credenciais de dev (troque fora de dev; README, "Fora de dev") ----
# As do Postgres e do Keycloak só valem no PRIMEIRO boot (volume pg-data vazio).
# Depois disso, mudar aqui não troca a senha: veja o README.
POSTGRES_PASSWORD=postgres
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
CATALOG_DB_PASSWORD=catalog
ORDERS_DB_PASSWORD=orders
PAYMENTS_DB_PASSWORD=payments
NOTIFICATIONS_DB_PASSWORD=notifications
IDENTITY_DB_PASSWORD=identity
MINIO_ROOT_USER=uzusis
MINIO_ROOT_PASSWORD=uzusis-minio-dev
MINIO_BUCKET=produtos

# ---- Stripe (vazio = pagamento desabilitado; o checkout avisa) ----
# Chaves de TESTE: Dashboard > Developers > API keys. O whsec sai de:
#   docker compose run --rm stripe-cli listen --api-key sk_test_... --print-secret
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# STRIPE_API_BASE=          # só no e2e (stripe-mock)
STRIPE_MOEDA=brl

# ---- Pedido e frete ----
FRETE_PADRAO=40.00
FRETE_POR_UF=CE=10.00       # UF=valor[,UF=valor]
PEDIDO_EXPIRACAO_MINUTOS=30

# ---- E-mail (notification-service e Keycloak); o padrão é o Mailpit ----
# O Keycloak (verificação de cadastro, "esqueci minha senha") lê SMTP_* e
# SMTP_FROM só no import do realm (primeiro boot); depois, é no console.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
EMAIL_FROM=Uzusis <nao-responda@uzusis.local>
SMTP_FROM=nao-responda@uzusis.local   # remetente do Keycloak: só o endereço do EMAIL_FROM

# ---- Observabilidade (com --profile observability) ----
TRACING_ENABLED=false

# ---- Legado (.NET + MySQL, só com --profile legacy) ----
# DB_NAME=uzusis
# DB_USER=
# DB_PASSWORD=
# DB_ROOT_PASSWORD=
# JWT_KEY=
# ASPNETCORE_ENVIRONMENT=Production
# ADMIN_NAME=Administrador
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
# EMAIL_USER=
# EMAIL_PASSWORD=
# EMAIL_SERVER=
# EMAIL_PORT=
# API_PORT=5141
