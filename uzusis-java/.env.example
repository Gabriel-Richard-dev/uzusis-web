# Chaves de TESTE da Stripe. Nunca comitar as de produção — nunca comitar
# nenhuma, na verdade: este arquivo é o exemplo, o .env fica fora do git.
STRIPE_SECRET_KEY=sk_test_troque_aqui
# Sai do comando: stripe listen --forward-to http://localhost:8090/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_troque_aqui

POSTGRES_PASSWORD=postgres

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Secret do client confidencial order-service (igual ao do realm importado).
ORDER_CLIENT_SECRET=order-service-secret

# API .NET antiga, para onde o gateway manda o que ainda não foi migrado.
LEGACY_API_URL=http://host.docker.internal:5141

GATEWAY_PORT=8090
CONNECT_PORT=8093
MAILPIT_PORT=8025
JAEGER_PORT=16686
