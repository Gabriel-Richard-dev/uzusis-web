{
  "realm": "uzusis",
  "enabled": true,
  "displayName": "Uzusis",
  "sslRequired": "none",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "resetPasswordAllowed": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "accessTokenLifespan": 900,

  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Administra catálogo e envio de pedidos"
      },
      {
        "name": "CUSTOMER",
        "description": "Cliente da loja"
      }
    ]
  },

  "defaultRole": {
    "name": "default-roles-uzusis",
    "composite": true,
    "clientRole": false,
    "containerId": "uzusis"
  },

  "clients": [
    {
      "clientId": "web-app",
      "name": "Loja (Angular)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:4200/*", "http://localhost:8080/*"],
      "webOrigins": ["http://localhost:4200", "http://localhost:8080"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*"
      }
    },
    {
      "clientId": "mobile-app",
      "name": "App mobile",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["uzusis://callback"],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      }
    },
    {
      "clientId": "order-service",
      "name": "order-service (serviço-a-serviço)",
      "enabled": true,
      "publicClient": false,
      "secret": "order-service-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {
        "use.refresh.tokens": "false"
      }
    }
  ],

  "users": [
    {
      "username": "admin@uzusis.local",
      "email": "admin@uzusis.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Admin",
      "lastName": "Uzusis",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": ["ADMIN", "CUSTOMER", "default-roles-uzusis"]
    },
    {
      "username": "cliente@uzusis.local",
      "email": "cliente@uzusis.local",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Cliente",
      "lastName": "de Teste",
      "credentials": [
        {
          "type": "password",
          "value": "cliente123",
          "temporary": false
        }
      ],
      "realmRoles": ["CUSTOMER", "default-roles-uzusis"]
    }
  ]
}
