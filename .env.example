# Copie para .env e preencha. O .env não vai para o repositório.

# ---- Banco ----
DB_NAME=uzusis
DB_USER=uzusis
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-esta-senha-root

# ---- Storage (MinIO) ----
MINIO_ROOT_USER=uzusis
MINIO_ROOT_PASSWORD=troque-esta-senha-minio
MINIO_BUCKET=produtos

# ---- API ----
# Chave do JWT: use algo longo e aleatório (ex: openssl rand -base64 48)
JWT_KEY=troque-por-uma-chave-longa-e-aleatoria
ASPNETCORE_ENVIRONMENT=Production

# Admin criado no primeiro boot. Deixe em branco para não criar nenhum.
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@uzusis.test
ADMIN_PASSWORD=troque-esta-senha-admin

# ---- E-mail (SMTP) ----
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_SERVER=smtp.gmail.com
EMAIL_PORT=587

# ---- Portas publicadas no host ----
WEB_PORT=8080
API_PORT=5141
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
